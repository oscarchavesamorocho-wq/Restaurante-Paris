# Copia este archivo como .env y ajusta los valores.
# NUNCA subas el .env real al repositorio.

# --- Servidor ---
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Origen público exacto de la aplicación (esquema + host + puerto).
# Se usa para comprobar el encabezado Origin en peticiones mutantes (CSRF).
APP_ORIGIN=http://localhost:3000

# Ruta del archivo SQLite (persistencia en servidor).
DB_PATH=./data/cafe-paris.sqlite

# Horas de validez de la sesión.
SESSION_HOURS=8

# true solo cuando la app se sirve por HTTPS. En producción se fuerza a true.
COOKIE_SECURE=false

# Zona horaria del restaurante (IANA). Se usa para "hoy", reservas y métricas.
RESTAURANT_TZ=America/Bogota

# Si está detrás de un proxy inverso de confianza, define el número de saltos.
TRUST_PROXY=0

# --- Demostración ---
# En NODE_ENV=production se fuerza a false salvo DEMO_MODE=true explícito.
DEMO_MODE=true
DEMO_ADMIN_EMAIL=admin@cafeparis.local
# Opcional SOLO para desarrollo local. Si se omite, se genera una contraseña
# aleatoria y se escribe en .demo-credentials.txt (ignorado por git).
# DEMO_ADMIN_PASSWORD=

# --- Google Identity Services (opcional) ---
# ID de cliente público de Google (termina en .apps.googleusercontent.com).
# Si está vacío, el inicio de sesión con Google queda deshabilitado.
# No inventes este valor ni incluyas el client secret aquí.
# Debe ser un cliente de tipo "Aplicación web" con tu origen exacto
# (por ejemplo http://localhost:3000) en "Authorized JavaScript origins".
# No se necesita redirect URI para el botón de Google Identity Services.
GOOGLE_CLIENT_ID=
